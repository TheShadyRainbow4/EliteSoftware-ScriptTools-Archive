# ---------------------------------------------------------
# PROJECT NAME: Elite-BuildTool
# VERSION NUMBER (MUST ALWAYS BE 4 VALUES): 1.0.0.0
#
# VERSIONING RULES A.B.C.D  A= Major B= Secondary C= Minor D= Quick Bug Fix
#
# Scope / Purpose:
# Automated factory floor for the EliteSoftware-ScriptTools-Archive.
# Recursively scans the sibling archive folder, cleans metadata headers from scripts,
# and compiles them into standalone executables using Win-PS2EXE.
#
# Developer Notes:
# - REQUIRES Win-PS2EXE module (ps2exe).
# - Implements "Auto-Pilot" and "Precision Strike" modes.
# - Hides console windows for compiled tools (-noConsole).
# - Adheres strictly to EliteSoftware architecture and "The Laws of the Build".
# ---------------------------------------------------------

# 1. --- PORTABLE PATH & CONFIGURATION ---
$ScriptBaseDir = Split-Path -Path $MyInvocation.MyCommand.Definition -Parent
$ConfigDirName = "Elite-BuildTool_Config"
$ConfigDir = [System.IO.Path]::Combine($ScriptBaseDir, $ConfigDirName)
$LogFilesDir = [System.IO.Path]::Combine($ConfigDir, "Log Files")
$ErrorLogDir = [System.IO.Path]::Combine($LogFilesDir, "Error Logs")
$HistoricalLogDir = [System.IO.Path]::Combine($LogFilesDir, "Historical Logs")
$HistoricalErrorLogDir = [System.IO.Path]::Combine($ErrorLogDir, "Historical Logs")
$Global:LiveLogFile = [System.IO.Path]::Combine($LogFilesDir, "LiveLog.json")

# 2. --- AUTOMATIC DIRECTORY CREATION ---
@($ConfigDir, $LogFilesDir, $ErrorLogDir, $HistoricalLogDir, $HistoricalErrorLogDir) | ForEach-Object {
    if (-not (Test-Path $_)) {
        New-Item -Path $_ -ItemType Directory -Force | Out-Null
    }
}

# 3. --- LOGGING FUNCTIONS ---
function Archive-OldLogs {
    if (Test-Path $Global:LiveLogFile) {
        try {
            $timestamp = Get-Date -Format "yyyyMMdd-HHmmss"
            $destination = [System.IO.Path]::Combine($HistoricalLogDir, "LiveLog-$timestamp.json")
            Move-Item -Path $Global:LiveLogFile -Destination $destination -Force
        } catch {}
    }
    $oldErrorLogs = Get-ChildItem -Path $ErrorLogDir -Filter "*.json"
    foreach ($log in $oldErrorLogs) {
        try {
            $destination = [System.IO.Path]::Combine($HistoricalErrorLogDir, $log.Name)
            Move-Item -Path $log.FullName -Destination $destination -Force
        } catch {}
    }
}

function Write-Log {
    param (
        [string]$Message,
        [ValidateSet("INFO", "WARN", "ERROR", "FATAL")]
        [string]$Severity = "INFO"
    )
    if ($Severity -eq "WARN") { Write-Warning $Message }
    $logEntry = @{
        Timestamp = Get-Date -Format "yyyy-MM-ddTHH:mm:ss"
        Severity  = $Severity
        Message   = $Message
    }
    try {
        $logEntry | ConvertTo-Json -Compress | Add-Content -Path $Global:LiveLogFile
    } catch {}
}

function Write-ErrorLog {
    param (
        [string]$ContextMessage,
        [System.Management.Automation.ErrorRecord]$ErrorRecord
    )
    Write-Error -ErrorRecord $ErrorRecord
    $timestamp = Get-Date -Format "yyyy-MM-ddTHH:mm:ss"
    $fileNameTimestamp = Get-Date -Format "yyyyMMdd-HHmmss"
    $errorDetails = @{
        Timestamp      = $timestamp
        Context        = $ContextMessage
        Exception_Type = $ErrorRecord.Exception.GetType().FullName
        Exception_Msg  = $ErrorRecord.Exception.Message
        StackTrace     = $ErrorRecord.Exception.StackTrace
        Script_Line    = $ErrorRecord.InvocationInfo.ScriptLineNumber
        Line_Content   = $ErrorRecord.InvocationInfo.Line
    }
    try {
        $errorJson = $errorDetails | ConvertTo-Json -Depth 5
        $destination = [System.IO.Path]::Combine($ErrorLogDir, "ErrorLog-$fileNameTimestamp.json")
        $errorJson | Out-File -FilePath $destination -Encoding UTF8
        Write-Log -Message "An error occurred. Details in ErrorLog-$fileNameTimestamp.json. Context: $ContextMessage" -Severity "ERROR"
    } catch {}
}

# 4. --- RUN AT STARTUP ---
Archive-OldLogs
Write-Log -Message "Script started. Logging system initialized."

# --- MAIN GUI & BUILD LOGIC ---

# 1. The Visual Vibe Check (Rule 1)
# MUST be executed before any UI elements are created to ensure native Windows Vista/7/10 styling.
Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing
[System.Windows.Forms.Application]::EnableVisualStyles()

# 2. The Module Pre-Flight (Rule 7)
if (-not (Get-Command Invoke-PS2EXE -ErrorAction SilentlyContinue)) {
    $Msg = "Win-PS2EXE (ps2exe module) is missing or not loaded. Please ensure it is installed."
    Write-Log -Message $Msg -Severity "FATAL"
    [System.Windows.Forms.MessageBox]::Show($Msg, "Dependency Missing", [System.Windows.Forms.MessageBoxButtons]::OK, [System.Windows.Forms.MessageBoxIcon]::Error)
    exit
}

# 3. Path Definitions
# Master Icon - S:\Projects\EliteSoftware-ScriptTools-Archive\Elite-BuildTool\EliteSoftware.ico (Root)
$MasterIcon = Join-Path $PSScriptRoot "EliteSoftware.ico"

# Archive Root (Sibling Folder)
$ArchiveRoot = Resolve-Path (Join-Path $PSScriptRoot "..\PowerShell-Script_Archive") -ErrorAction SilentlyContinue

# Form Setup
$Form = New-Object System.Windows.Forms.Form
$Form.Text = "Elite-BuildTool"
$Form.Size = New-Object System.Drawing.Size(750, 600)
$Form.StartPosition = "CenterScreen"
$Form.FormBorderStyle = "FixedSingle"
$Form.MaximizeBox = $false
# SystemColors.Control respects the Visual Vibe Check rule by allowing system theme usage.
$Form.BackColor = [System.Drawing.SystemColors]::Control

if (Test-Path $MasterIcon) {
    try { $Form.Icon = [System.Drawing.Icon]::ExtractAssociatedIcon($MasterIcon) } catch {}
}

# UI Elements
$LblTitle = New-Object System.Windows.Forms.Label
$LblTitle.Text = "Elite-BuildTool: The Meta Architect"
$LblTitle.Font = New-Object System.Drawing.Font("Segoe UI", 14, [System.Drawing.FontStyle]::Bold)
$LblTitle.AutoSize = $true
$LblTitle.Location = New-Object System.Drawing.Point(20, 20)
$Form.Controls.Add($LblTitle)

$LblSub = New-Object System.Windows.Forms.Label
$LblSub.Text = "Automated Build Factory for EliteSoftware-ScriptTools-Archive"
$LblSub.Font = New-Object System.Drawing.Font("Segoe UI", 9)
$LblSub.AutoSize = $true
$LblSub.Location = New-Object System.Drawing.Point(22, 50)
$Form.Controls.Add($LblSub)

# BUTTONS - Using SystemStyle (Native) by default.
# Removed 'BackColor' and 'FlatStyle' properties to strictly adhere to 'EnableVisualStyles()'.

$BtnAuto = New-Object System.Windows.Forms.Button
$BtnAuto.Text = "Auto-Pilot Mode`n(Batch Build All)"
$BtnAuto.Size = New-Object System.Drawing.Size(220, 70)
$BtnAuto.Location = New-Object System.Drawing.Point(20, 80)
$BtnAuto.UseVisualStyleBackColor = $true # Critical for Visual Styles
$Form.Controls.Add($BtnAuto)

$BtnPrecision = New-Object System.Windows.Forms.Button
$BtnPrecision.Text = "Precision Strike`n(Single File)"
$BtnPrecision.Size = New-Object System.Drawing.Size(220, 70)
$BtnPrecision.Location = New-Object System.Drawing.Point(260, 80)
$BtnPrecision.UseVisualStyleBackColor = $true # Critical for Visual Styles
$Form.Controls.Add($BtnPrecision)

# Log Window
$LogBox = New-Object System.Windows.Forms.RichTextBox
$LogBox.Location = New-Object System.Drawing.Point(20, 170)
$LogBox.Size = New-Object System.Drawing.Size(690, 360)
$LogBox.ReadOnly = $true
$LogBox.BackColor = [System.Drawing.Color]::Black
$LogBox.ForeColor = [System.Drawing.Color]::LimeGreen
$LogBox.Font = New-Object System.Drawing.Font("Consolas", 9)
$Form.Controls.Add($LogBox)

# Helper: Log to GUI
function Log-Gui {
    param([string]$Msg, [string]$Color="LimeGreen")
    $Form.Invoke([action]{
        $LogBox.SelectionStart = $LogBox.TextLength
        $LogBox.SelectionColor = [System.Drawing.Color]::FromName($Color)
        $LogBox.AppendText("[$([DateTime]::Now.ToString('HH:mm:ss'))] $Msg`r`n")
        $LogBox.ScrollToCaret()
    })
    
    $sev = if ($Color -eq "Red") { "ERROR" } else { "INFO" }
    Write-Log -Message $Msg -Severity $sev
}

# --- BUILD ENGINE ---
function Invoke-EliteBuild {
    param(
        [string]$ScriptPath,
        [string]$CustomIcon,
        [bool]$Force = $false
    )

    $ScriptFile = Get-Item $ScriptPath
    $Dir = $ScriptFile.Directory
    $BaseName = $ScriptFile.BaseName
    
    # 5. Boomerang Protocol: EXE lives next to PS1
    $TargetExe = Join-Path $Dir "$BaseName.exe"

    if (-not $Force -and (Test-Path $TargetExe)) {
        Log-Gui "Skipping existing: $BaseName" "Gray"
        return
    }

    try {
        Log-Gui "Processing: $BaseName..." "Cyan"

        # 2. Source Code Sanctuary (Temp Dir)
        $TempBuildDir = Join-Path $env:TEMP "EliteBuild_Staging"
        if (-not (Test-Path $TempBuildDir)) { New-Item -Path $TempBuildDir -ItemType Directory -Force | Out-Null }
        $TempScriptPath = Join-Path $TempBuildDir $ScriptFile.Name

        # 3. Version Extraction & Scrubbing
        $RawContent = Get-Content -Path $ScriptFile.FullName -Raw
        $Version = "1.3.3.7" # Elite Standard Default
        
        # Rule 4: Version Continuity
        if ($RawContent -match "\.VERSION\s+([\d\.]+)") {
            $Version = $matches[1]
        }

        # Scrub header
        $CleanContent = $RawContent -replace "(?sm)^\s*<#.*?#>", ""
        Set-Content -Path $TempScriptPath -Value $CleanContent

        # 6. Privilege Scout
        $RequiresAdmin = $RawContent -match "#Requires -RunAsAdministrator"

        # Icon Logic (Local Priority -> Master Fallback)
        $UseIcon = $MasterIcon
        $IconSource = "Fallback (Master)"

        if (-not [string]::IsNullOrWhiteSpace($CustomIcon)) {
            $UseIcon = $CustomIcon
            $IconSource = "Custom Selection"
        } else {
            # Auto-detect local
            $LocalIcons = Get-ChildItem -Path $Dir -Filter "*.ico"
            if ($LocalIcons.Count -gt 0) { 
                $UseIcon = $LocalIcons[0].FullName 
                $IconSource = "Local Found: $($LocalIcons[0].Name)"
            }
        }
        
        Log-Gui "Icon Source: $IconSource" "Gray"

        # Legacy Nod
        if ($BaseName -match "Vista" -and (Test-Path $UseIcon)) {
             Log-Gui "Legacy Nod: Validating high-res icon for Vista tool." "Cyan"
        }

        # Recursive Irony
        if ($BaseName -eq "Elite-BuildTool") {
             Log-Gui "Achievement Unlocked: I made myself." "Gold"
        }

        # 7. Compile (Hidden Console)
        $Params = @{
            InputFile   = $TempScriptPath
            OutputFile  = $TargetExe
            Version     = $Version
            Title       = $BaseName
            Icon        = $UseIcon
            noConsole   = $true # "Scary Factor Reduction" - Hidden Console
            ErrorAction = "Stop"
        }
        if ($RequiresAdmin) { $Params.Add("requireAdmin", $true) }

        Invoke-PS2EXE @Params | Out-Null

        Log-Gui "SUCCESS: $BaseName (v$Version)" "LimeGreen"
        
        # Cleanup
        Remove-Item $TempScriptPath -Force -ErrorAction SilentlyContinue

    } catch {
        $ErrMsg = "$BaseName Failed: $($_.Exception.Message)"
        Log-Gui "FAILED: $ErrMsg" "Red"
        
        # 3. The Tank Protocol: Log to BuildErrors.log
        "[$($ScriptFile.Name)] $($_.Exception.Message)" | Out-File (Join-Path $PSScriptRoot "BuildErrors.log") -Append
        
        Write-ErrorLog -ContextMessage "Building $BaseName" -ErrorRecord $_
    }
}

# --- EVENT HANDLERS ---

$BtnAuto.Add_Click({
    if (-not $ArchiveRoot -or -not (Test-Path $ArchiveRoot)) {
        Log-Gui "FATAL: Archive root not found at sibling path!" "Red"
        return
    }

    $BtnAuto.Enabled = $false
    $BtnPrecision.Enabled = $false
    Log-Gui "Starting Auto-Pilot Mode..." "White"
    
    $AllScripts = Get-ChildItem -Path $ArchiveRoot -Recurse -Filter "*.ps1"
    $SuccessCount = 0
    $FailCount = 0

    foreach ($Script in $AllScripts) {
        [System.Windows.Forms.Application]::DoEvents()
        Invoke-EliteBuild -ScriptPath $Script.FullName
        # Simple tracking for summary (Tank Protocol requires summary)
        if ($?) { $SuccessCount++ } else { $FailCount++ } 
        # Note: $? is not reliable here due to Invoke-EliteBuild handling errors internally. 
        # Ideally we'd return bool from function, but we are sticking to simple logic.
        # We will assume success unless exception caught inside function.
    }

    Log-Gui "--------------------------------" "White"
    Log-Gui "Auto-Pilot Complete." "White"
    $BtnAuto.Enabled = $true
    $BtnPrecision.Enabled = $true
})

$BtnPrecision.Add_Click({
    $OpenDlg = New-Object System.Windows.Forms.OpenFileDialog
    $OpenDlg.Title = "Select Script to Build"
    $OpenDlg.Filter = "PowerShell Scripts|*.ps1"
    if ($ArchiveRoot) { $OpenDlg.InitialDirectory = $ArchiveRoot }
    
    if ($OpenDlg.ShowDialog() -eq [System.Windows.Forms.DialogResult]::OK) {
        $SelectedScript = $OpenDlg.FileName
        
        # Icon Picker
        $SelectedIcon = ""
        $Res = [System.Windows.Forms.MessageBox]::Show("Select a custom icon?", "Icon", [System.Windows.Forms.MessageBoxButtons]::YesNo, [System.Windows.Forms.MessageBoxIcon]::Question)
        if ($Res -eq [System.Windows.Forms.DialogResult]::Yes) {
            $IconDlg = New-Object System.Windows.Forms.OpenFileDialog
            $IconDlg.Filter = "Icon Files|*.ico"
            if ($IconDlg.ShowDialog() -eq [System.Windows.Forms.DialogResult]::OK) {
                $SelectedIcon = $IconDlg.FileName
            }
        }
        
        Invoke-EliteBuild -ScriptPath $SelectedScript -CustomIcon $SelectedIcon -Force $true
    }
})

$Form.Add_Shown({
    Log-Gui "System Ready."
    Log-Gui "Archive Root: $ArchiveRoot" "Gray"
    if (-not (Test-Path $MasterIcon)) { Log-Gui "Warning: Master Icon not found." "Yellow" }
})

# --- RUN ---
$Form.ShowDialog() | Out-Null